<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project>
  <Type Name="pb"/>
  <Application Name="pfcsecurity_admin"/>
  <DeployConfigurations OutputDirectory="Build\bin\$(ConfigurationName)">
    <DeployConfiguration Name="p_pfcsecurity_admin_exe" Path="security administrator\pfcsecad.pbl\p_pfcsecurity_admin_exe.srj"/>
  </DeployConfigurations>
  <Libraries AppEntry="security administrator\pfcsecad.pbl">
